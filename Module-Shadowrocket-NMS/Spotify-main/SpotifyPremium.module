[Header Rewrite]
http-request ^https:\/\/(?:spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
spotify_request=type=http-request,pattern=^https:\/\/(?:spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/(?:artistview\/v1\/artist|album-entity-view\/v2\/album)(?:[/?#]|$),requires-body=0,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket---NMS/refs/heads/main/Spotify-main/fixsp?token=GHSAT0AAAAAAEAMDZVEJLDA5MSB454LNOKW2US227A
spotify_response=type=http-response,pattern=^https:\/\/(?:spclient\.wg\.spotify\.com|[A-Za-z0-9-]+-spclient\.spotify\.com(?::443)?)\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket---NMS/refs/heads/main/Spotify-main/S1.js?token=GHSAT0AAAAAAEAMDZVFV7IC4BCJJACEWUK62US23LQ

[MITM]
hostname = %APPEND% *spclient.spotify.com,spclient.wg.spotify.com
